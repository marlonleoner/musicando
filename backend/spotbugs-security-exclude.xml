<FindBugsFilter>
    <!-- Apenas sinaliza que a classe é um endpoint Spring para revisão manual; não indica uma vulnerabilidade -->
    <Match>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- Títulos de músicas são apenas exibidos e comparados entre si; a conversão para caixa alta não participa de nenhuma
         verificação de segurança -->
    <Match>
        <Class name="com.marlonleoner.musicando.util.TitleNormalizer"/>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>
</FindBugsFilter>