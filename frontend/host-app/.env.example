# URL do backend. Sem valor, usa o mesmo endereço pelo qual a página foi aberta, na porta 8080.
VITE_API_BASE_URL=

# URL do player-app aberta pelo QR code. Sem valor, usa o mesmo endereço pelo qual a página foi aberta, na porta 5174.
# Em desenvolvimento, abra o host-app pelo IP da máquina (ex.: http://192.168.0.15:5173) para o QR funcionar no celular.
VITE_PLAYER_APP_URL=
